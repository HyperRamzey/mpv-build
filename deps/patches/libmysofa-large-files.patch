diff --git a/src/hdf/dataobject.c b/src/hdf/dataobject.c
index 1ccf089..122ec44 100644
--- a/src/hdf/dataobject.c
+++ b/src/hdf/dataobject.c
@@ -217,7 +217,7 @@ static int readOHDRHeaderMessageDatatype(struct READER *reader,
 
   dt->class_bit_field = (uint32_t)readValue(reader, 3);
   dt->size = (uint32_t)readValue(reader, 4);
-  if (dt->size > 64)
+  if (dt->size > 4096) /* long fixed-string attributes are legitimate */
     return MYSOFA_UNSUPPORTED_FORMAT; // LCOV_EXCL_LINE
 
   switch (dt->class_and_version & 0xf) {
